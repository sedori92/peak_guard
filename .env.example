# Supabase 대시보드 > Project Settings > Database > Connection string (URI)
# [YOUR-PASSWORD] 를 실제 비밀번호로 바꾸고, 이 파일을 .env 로 복사해서 사용하세요.
# 비워두면 로컬 SQLite 파일(peakguard.db)을 사용합니다.
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ---- [실시간 연결] 기업 DB 직접 연결 (선택) ----
# 비워두면 data/incoming/ 폴더의 CSV만 확인합니다. 쿼리는 :after (마지막 실측 시각) 이후 행을
# 전력 CSV와 같은 순서(전력량계 ID, 채널 번호, 측정 시간, 현재 전력, 누적 사용량, 수요 전력)로 돌려주게 작성합니다.
LIVE_DB_URL=
LIVE_DB_QUERY=

# ---- 경보 발령 메일 (선택) ---- 비워두면 발령은 '경보 발령 기록 장부'에만 남습니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
